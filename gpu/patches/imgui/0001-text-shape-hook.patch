 void ImFont::RenderText(ImDrawList* draw_list, float size, const ImVec2& pos, ImU32 col, const ImVec4& clip_rect, const char* text_begin, const char* text_end, float wrap_width, ImDrawTextFlags flags)
 {
+    if (GImFontTextShape && !(flags & ImDrawTextFlags_Shaped))
+    {
+        // Lines are laid out on the shaped text in logical order, then drawn in display order.
+        if (!text_end)
+            text_end = text_begin + ImStrlen(text_begin);
+        const char* shaped_end = NULL;
+        if (const char* shaped = GImFontTextShape(text_begin, text_end, 0, &shaped_end))
+        {
+            const ImDrawTextFlags line_flags = flags | ImDrawTextFlags_Shaped;
+            float y = pos.y;
+            for (const char* s = shaped; s < shaped_end && y <= clip_rect.w; y += size)
+            {
+                const char* line_end = (const char*)ImMemchr(s, '\n', (size_t)(shaped_end - s));
+                if (!line_end)
+                    line_end = shaped_end;
+                const char* eol = line_end;
+                if (wrap_width > 0.0f)
+                {
+                    eol = ImFontCalcWordWrapPositionEx(this, size, s, line_end, wrap_width, line_flags);
+                    if (eol <= s) { unsigned int c; eol = s + ImTextCharFromUtf8(&c, s, line_end); }
+                }
+                const char* visual_end = NULL;
+                const char* visual = GImFontTextShape(s, eol, 1, &visual_end);
+                RenderText(draw_list, size, ImVec2(pos.x, y), col, clip_rect, visual ? visual : s, visual ? visual_end : eol, 0.0f, line_flags);
+                s = eol < line_end ? ImTextCalcWordWrapNextLineStart(eol, shaped_end, flags) : line_end + (line_end < shaped_end ? 1 : 0);
