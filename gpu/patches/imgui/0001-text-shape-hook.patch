+            if (out_remaining != NULL)
+            {
+                const char* s = text_begin;
+                for (const char* p = shaped; p < rest && s < text_end; )
+                {
+                    unsigned int c;
+                    p += ImTextCharFromUtf8(&c, p, shaped_end);
+                    s += ImTextCharFromUtf8(&c, s, text_end);
